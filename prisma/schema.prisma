generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model documents {
  id            Int                 @id @default(autoincrement())
  submission_id String?
  doc_type      documents_doc_type?
  file_path     String?             @db.VarChar(255)
  is_signed     Boolean?            @default(false)
  uploaded_at   DateTime            @default(now()) @db.Timestamp(0)
  submissions   submissions?        @relation(fields: [submission_id], references: [id])

  @@index([submission_id])
}

model master_dtsen {
  nik            String   @id @db.VarChar(255)
  nama_lengkap   String?  @db.VarChar(255)
  alamat_lengkap String?  @db.Text
  is_active      Boolean? @default(true)
}

model matching_results {
  id               Int                            @id @default(autoincrement())
  submission_id    String?
  nik_usulan       String?                        @db.VarChar(255)
  nama_usulan      String?                        @db.VarChar(255)
  nik_master       String?                        @db.VarChar(255)
  nama_master      String?                        @db.VarChar(255)
  similarity_score Decimal?                       @db.Decimal(5, 2)
  status_padan     matching_results_status_padan?
  alasan_anomali   String?                        @db.Text
  submissions      submissions?                   @relation(fields: [submission_id], references: [id])

  @@index([submission_id])
}

model submissions {
  id                 String                 @id
  user_id            Int?
  file_name          String?                @db.VarChar(255)
  file_type          submissions_file_type?
  status             submissions_status?    @default(PENDING)
  sla_deadline       DateTime?              @db.DateTime(0)
  created_at         DateTime               @default(now()) @db.Timestamp(0)
  total_rows         Int?                   @default(0)
  valid_rows         Int?                   @default(0)
  original_file_data String?                @db.LongText
  documents          documents[]
  matching_results   matching_results[]
  users              users?                 @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model users {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  name        String
  role        users_role
  instansi    String?
  createdAt   DateTime      @default(now())
  submissions submissions[]
}

enum documents_doc_type {
  BAST
  NDA
  MOU
}

enum submissions_file_type {
  CSV
  XLSX
  IMAGE
}

enum submissions_status {
  PENDING
  VALIDATED
  MATCHING
  COMPLETED
  FAILED
}

enum users_role {
  PEMDA
  BPS_ADMIN
  BPS_PEGAWAI
}

enum matching_results_status_padan {
  EXACT_MATCH
  NO_MATCH
  PROBABLE_MATCH
}

model DtsenMaster {
  id              Int      @id @default(autoincrement())
  nik             String   @unique
  nama            String
  tanggal_lahir   DateTime
  jenis_kelamin   String
  alamat_lengkap  String
  provinsi        String
  kabupaten_kota  String
  kecamatan       String
  desa_kelurahan  String
  desil           Int      @default(0)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@index([nik])
  @@index([nama, tanggal_lahir])
}

model SasaranPemda {
  id              Int      @id @default(autoincrement())
  assignment_id   String
  nik_sasaran     String?
  nama_sasaran    String
  tanggal_lahir   DateTime
  jenis_kelamin   String
  alamat          String
  status_match    String   @default("PENDING")
  score_match     Float?
  
  dtsen_id        Int?
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([assignment_id])
}

model registration_requests {
  id                    String               @id @default(uuid())
  kategori_instansi     String               @db.VarChar(100)
  nama_instansi         String               @db.VarChar(255)
  email_narahubung      String               @db.VarChar(255)
  nama_narahubung       String               @db.VarChar(255)
  no_hp_narahubung      String               @db.VarChar(50)
  surat_permohonan_path String               @db.VarChar(255)
  status                registration_status  @default(PENDING)
  alasan_penolakan      String?              @db.Text
  created_at            DateTime             @default(now()) @db.Timestamp(0)
  
  users                 registration_users[]
}

model registration_users {
  id              Int                   @id @default(autoincrement())
  request_id      String
  nip_nik         String                @db.VarChar(100)
  nama_lengkap    String                @db.VarChar(255)
  nama_unit_kerja String                @db.VarChar(255)
  no_hp           String                @db.VarChar(50)
  email           String                @db.VarChar(255)
  jabatan         String                @db.VarChar(255)

  request         registration_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
}

enum registration_status {
  PENDING
  APPROVED
  REJECTED
}

model support_tickets {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  pesan      String   @db.Text
  status     String   @default("OPEN")
  created_at DateTime @default(now()) @db.Timestamp(0)
}
